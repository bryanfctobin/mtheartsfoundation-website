---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="landing-page">
		<h1>MT Hearts Foundation</h1>

		<footer>
			<a
				href="https://bryantobin.com/marlene/"
				target="_blank"
				rel="noopener noreferrer"
			>
				Memorial Video
			</a>
		</footer>
	</main>
</Layout>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,600&display=swap');

	:global(html),
	:global(body) {
		margin: 0;
		min-height: 100%;
	}

	:global(body) {
		background: #c75b7a;
		font-family: Arial, Helvetica, sans-serif;
	}

	.landing-page {
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		align-items: center;
		min-height: 100vh;
		padding: 3rem 1.5rem 2rem;
		text-align: center;
		color: #ffffff;
	}

	h1 {
		margin: auto 0;
		font-family: 'Cormorant Garamond', Georgia, serif;
		font-size: clamp(3.75rem, 11vw, 9rem);
		font-style: italic;
		font-weight: 600;
		line-height: 0.95;
		letter-spacing: -0.025em;
		text-wrap: balance;
	}

	footer {
		width: 100%;
		padding-top: 2rem;
	}

	footer a {
		color: #ffffff;
		font-size: 1rem;
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 0.3rem;
	}

	footer a:hover,
	footer a:focus-visible {
		text-decoration-thickness: 0.15rem;
	}
</style>