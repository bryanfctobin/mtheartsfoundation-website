---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main
		class="mtnbc-page"
		aria-label="MTNBC metastatic breast cancer awareness colors"
	>
		<div class="pattern"></div>
	</main>
</Layout>

<style>
	:global(html),
	:global(body) {
		margin: 0;
		width: 100%;
		min-height: 100%;
		background: #ec5f8d;
		overflow: hidden;
	}

	.mtnbc-page {
		position: relative;
		width: 100vw;
		height: 100vh;
		height: 100svh;
		overflow: hidden;
		background: #ec5f8d;
	}

	.pattern {
		position: absolute;

		/*
			Slightly oversized so movement never exposes
			the background around the edges.
		*/
		inset: -12%;

		background:
			linear-gradient(
				115deg,

				#ec5f8d 0%,
				#ec5f8d 18%,

				#ffffff 18%,
				#ffffff 18.25%,

				#008080 18.25%,
				#008080 31%,

				#ffffff 31%,
				#ffffff 31.25%,

				#008000 31.25%,
				#008000 44%,

				#ffffff 44%,
				#ffffff 44.25%,

				#ec5f8d 44.25%,
				#ec5f8d 62.25%,

				#ffffff 62.25%,
				#ffffff 62.5%,

				#008080 62.5%,
				#008080 75.25%,

				#ffffff 75.25%,
				#ffffff 75.5%,

				#008000 75.5%,
				#008000 88.25%,

				#ffffff 88.25%,
				#ffffff 88.5%,

				#ec5f8d 88.5%,
				#ec5f8d 100%
			);

		background-size: 100% 100%;
		background-repeat: no-repeat;

		animation: barber-drift 30s linear infinite;
		will-change: transform;
	}

	/*
		Slow, one-direction diagonal movement,
		similar to a barber pole.
	*/
	@keyframes barber-drift {
		from {
			transform: translate3d(-3%, -3%, 0);
		}

		to {
			transform: translate3d(3%, 3%, 0);
		}
	}

	@media (max-width: 600px) {
		.pattern {
			inset: -16%;

			background:
				linear-gradient(
					115deg,

					#ec5f8d 0%,
					#ec5f8d 22%,

					#ffffff 22%,
					#ffffff 22.3%,

					#008080 22.3%,
					#008080 37%,

					#ffffff 37%,
					#ffffff 37.3%,

					#008000 37.3%,
					#008000 52%,

					#ffffff 52%,
					#ffffff 52.3%,

					#ec5f8d 52.3%,
					#ec5f8d 74.3%,

					#ffffff 74.3%,
					#ffffff 74.6%,

					#008080 74.6%,
					#008080 89.3%,

					#ffffff 89.3%,
					#ffffff 89.6%,

					#008000 89.6%,
					#008000 100%
				);

			background-size: 100% 100%;
			background-repeat: no-repeat;

			animation-duration: 35s;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.pattern {
			animation: none;
			transform: none;
		}
	}
</style>